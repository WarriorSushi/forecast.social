# Copy this file to .env.local and fill in real values. Never commit .env.local.
# Required vars are validated at module load by src/lib/env.ts.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Postgres — direct connection, not the pooler. Drizzle migrations need direct.
# Project Settings → Database → Connection string → URI (direct)
DATABASE_URL="postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres"

# Public site URL — used for OAuth callbacks, share-card og:image, etc.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
